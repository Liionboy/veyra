# Docker Compose reads application secrets from .secrets/.
# All byte limits below are integers; 0 disables the matching quota.
VEYRA_HOST=0.0.0.0
VEYRA_PORT=8080
VEYRA_BASE_URL=http://localhost:8080
VEYRA_DATA_DIR=./data

# Capacity
VEYRA_MAX_FILE_SIZE=10737418240
VEYRA_MAX_SHARE_SIZE=53687091200
VEYRA_DEFAULT_USER_QUOTA=107374182400
VEYRA_INSTANCE_QUOTA=0
VEYRA_MIN_FREE_BYTES=5368709120
VEYRA_MAX_FILES_PER_SHARE=500

# Resumable uploads
VEYRA_UPLOAD_CHUNK_SIZE=8388608
VEYRA_UPLOAD_SESSION_HOURS=24

# Set both true only behind the trusted HTTPS reverse proxy.
VEYRA_TRUST_PROXY=false
VEYRA_SECURE_COOKIES=false
